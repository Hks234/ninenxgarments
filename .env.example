# Local MySQL for this project only (port 3307 avoids other MySQL installs)
DATABASE_URL="mysql://ninexn:ninexn_pass@127.0.0.1:3307/nine_xn_garments"
MYSQL_PORT="3307"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Session secrets (generate a long random string)
SESSION_SECRET="replace-with-a-long-random-secret"

# Development OTP display. Set to false in production.
OTP_DISPLAY_MODE="true"

# Razorpay — leave empty until credentials are provided
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Seed demo catalogue data (never enable against production data)
SEED_DEMO="false"
